# Set this in the Mental Gaming Store Vercel project before building.
# Vite embeds VITE_* variables into the browser bundle at build time.
VITE_API_URL=https://mental-gaming-api.vercel.app
# Bot username without the @ symbol; the domain must also be set with BotFather /setdomain.
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
