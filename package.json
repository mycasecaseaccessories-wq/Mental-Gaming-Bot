{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build:api-bundle": "node scripts/build-api-bundle.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build --force --pretty false",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:bot": "pnpm --filter @workspace/bot test",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json .prettierrc.json .github/workflows/ci.yml artifacts/*/package.json artifacts/mockup-sandbox/vite.config.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "test:api": "pnpm --filter @workspace/api-server test",
    "smoke:api-bundle": "node scripts/smoke-api-bundle.mjs",
    "test:api:integration": "pnpm --filter @workspace/api-server test:integration"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
